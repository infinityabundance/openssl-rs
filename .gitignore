# Rust
/target
**/*.rs.bk

# Authority material is large and content-addressed. The registry
# (forensics/authorities/AUTHORITIES.json) IS checked in, because it is the
# evidence that binds claims to hashes. The per-file SOURCE_MANIFEST.*.json is
# also checked in: it is tamper-evidence for the extracted source tree, so that
# the recorded root hash is verifiable without re-downloading. Only the
# archives, extracted trees, build directories and installed prefixes are
# reproducible-and-ignored.
/forensics/authorities/downloads/
/forensics/authorities/src/
/forensics/authorities/build/
/forensics/authorities/prefix/
/forensics/authorities/captures/

# Court scratch material produced inside the container.
/court/

# Phase 2 distribution shell: the bulky artifacts are generated and reproducible
# from forensics/tools/build_phase2.sh (the version scripts, pkg-config metadata,
# shell manifest and court results ARE committed as evidence).
/artifacts/phase2/*.so
/artifacts/phase2/*.so.*
/artifacts/phase2/*.a
/artifacts/phase2/include/
/artifacts/phase2/shell/

# Gemel's evidence-native store. It IS committed: docs/RELEASE_GATES.md §2
# requires a Gemel checkpoint at every phase boundary, and a checkpoint that
# lives only on the machine that made it is prose, not evidence. The store is
# ~95 MB because Gemel snapshots the derived atlas; that is the cost of the
# trajectory being real and inspectable (`gemel log`, `gemel show`,
# `gemel why`). A human-readable projection is also committed at
# forensics/GEMEL_TRAJECTORY.md so the trajectory is legible without the store.

# FRF's portable OpenReceipt bundles are DERIVED exports of the committed .frf
# store (each ~20 MB: the closure includes the snapshotted authority DSOs).
# They are reproducible from the documented command, so they are not duplicated
# in git; the store they export from is committed.
/forensics/frf/bundles/

# Editor / OS noise
*.swp
.DS_Store

# Python bytecode. Generated interpreter state must never sit beside forensic
# tooling: it is not evidence, it is not reproducible, and in a project whose
# whole claim is reproducibility it is actively misleading.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
