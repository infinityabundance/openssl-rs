/*
 * openssl-rs — RT-BN: the `BIGNUM` surface, differentially.
 *
 * One program, compiled twice — against the admitted authority and against the
 * candidate distribution shell — and its transcript compared line by line. Every
 * line is `key=value`, so a divergence produces exactly one residual instead of
 * shifting every following line.
 *
 * What is compared, and why these things
 * --------------------------------------
 * `BIGNUM` is opaque, so almost nothing about it is layout. What a caller can
 * observe is: the value it reads back (through the conversions), the sign, the
 * bit length, the predicate answers, the return classes, and — for the operations
 * that can fail — what the error queue holds afterwards. The probe drives all of
 * those, and it drives them on *shapes* rather than on one example each: zero,
 * one, a single limb, exactly one limb boundary, two limbs, a value with the top
 * bit set, and negatives of those. The division family is checked against its own
 * definition (`a == b*q + r`, `|r| < |b|`, `r` takes the dividend's sign) because
 * that is the property a caller relies on, and it is checked on both sides by the
 * same code so the property itself cannot be the thing that differs.
 *
 * Fault boundaries
 * ----------------
 * A probe cannot compare a crash, so where the authority faults the probe does not
 * call. `BN_is_zero(NULL)` is one such case: the authority dereferences, the
 * candidate answers 1, and the divergence is recorded in
 * `docs/SECURITY_DIVERGENCE_POLICY.md` rather than exercised here.
 *
 * Scope
 * -----
 * This is a differential-compatibility result for the behaviours the probe
 * exercises, on one platform, for one build profile. It is NOT cryptographic or
 * security evidence, and it is NOT evidence about any symbol the probe does not
 * call (`docs/PARITY_MODEL.md`).
 *
 * SPDX-License-Identifier: Apache-2.0
 */
#include <openssl/bn.h>
#include <openssl/crypto.h>
#include <openssl/err.h>
#include <stdio.h>
#include <string.h>

static BN_CTX *ctx;

/*
 * Two exports are present in the authority's DSO but absent from its installed
 * headers at this build profile — the "exported, not declared" class the Phase 1
 * atlas records in `surface-reconciliation.json`. A C consumer could only reach
 * them by declaring them, so the probe does exactly that. The prototypes are the
 * authority's own, taken from the atlas rather than guessed.
 */
/* The probe uses `BN_mod`, which the authority declares as a macro over
 * `BN_div`, and avoids `BN_mod_rshift` and `BN_sqrt`, which this build profile
 * does not export at all. */

/* Print `key=<hex>`, or `key=NULL` for a null object. */
static void show(const char *key, const BIGNUM *a)
{
    char *hex;

    if (a == NULL) {
        printf("%s=NULL\n", key);
        return;
    }
    hex = BN_bn2hex(a);
    printf("%s=%s\n", key, hex != NULL ? hex : "(alloc-failed)");
    OPENSSL_free(hex);
}

/* Print the sign and bit length of a value, which are what a caller can read
 * without a conversion. */
static void shape(const char *key, const BIGNUM *a)
{
    printf("%s.neg=%d\n", key, a != NULL ? BN_is_negative(a) : -1);
    printf("%s.bits=%d\n", key, a != NULL ? BN_num_bits(a) : -1);
    printf("%s.zero=%d\n", key, a != NULL ? BN_is_zero(a) : -1);
    printf("%s.one=%d\n", key, a != NULL ? BN_is_one(a) : -1);
    printf("%s.odd=%d\n", key, a != NULL ? BN_is_odd(a) : -1);
}

/* A value from hex, with the sign the string carries. */
static BIGNUM *bn(const char *hex)
{
    BIGNUM *a = NULL;

    if (BN_hex2bn(&a, hex) == 0)
        return NULL;
    return a;
}

/* The division identity, checked by the same code on both sides: `a == b*q + r`,
 * `|r| < |b|`, and the remainder's sign follows the dividend's. */
static void division_case(const char *key, const char *ah, const char *bh)
{
    BIGNUM *a = bn(ah), *b = bn(bh), *q = BN_new(), *r = BN_new(), *back = BN_new();
    int ok;

    if (a == NULL || b == NULL || q == NULL || r == NULL || back == NULL) {
        printf("%s=setup-failed\n", key);
        goto out;
    }
    ok = BN_div(q, r, a, b, ctx);
    printf("%s.ret=%d\n", key, ok);
    if (!ok)
        goto out;
    show(key, NULL);
    printf("%s.q=", key);
    {
        char *h = BN_bn2hex(q);
        printf("%s\n", h != NULL ? h : "(null)");
        OPENSSL_free(h);
    }
    printf("%s.r=", key);
    {
        char *h = BN_bn2hex(r);
        printf("%s\n", h != NULL ? h : "(null)");
        OPENSSL_free(h);
    }
    /* back = b*q + r, which must equal a exactly. */
    if (BN_mul(back, b, q, ctx) && BN_add(back, back, r))
        printf("%s.identity=%d\n", key, BN_cmp(back, a) == 0);
    else
        printf("%s.identity=e\n", key);
    printf("%s.r_lt_b=%d\n", key, BN_ucmp(r, b) < 0);
    printf("%s.r_sign_follows_a=%d\n",
           key, BN_is_zero(r) || BN_is_negative(r) == BN_is_negative(a));
    /* BN_mod shares BN_div's remainder, and BN_nnmod never goes negative. */
    {
        BIGNUM *m = BN_new();
        if (m != NULL && BN_mod(m, a, b, ctx)) {
            printf("%s.mod_matches_r=%d\n", key, BN_cmp(m, r) == 0);
        }
        if (m != NULL && BN_nnmod(m, a, b, ctx)) {
            printf("%s.nnmod_neg=%d\n", key, BN_is_negative(m));
            printf("%s.nnmod_lt_b=%d\n", key, BN_ucmp(m, b) < 0);
        }
        BN_free(m);
    }
out:
    BN_free(a);
    BN_free(b);
    BN_free(q);
    BN_free(r);
    BN_free(back);
}

/*
 * `BN_GENCB` — the prime-generation callback object.
 *
 * The two registration functions do not store the same kind of function. The
 * new-style callback returns `int` and its result is what `BN_GENCB_call`
 * answers; the deprecated one returns `void` and `BN_GENCB_call` answers `1`
 * after invoking it. A caller's generation loop branches on that answer, so the
 * difference is contract, and it is the difference the prototype court found in
 * the crate's declaration of `BN_GENCB_set_old` (docs/DECISIONS.md D74).
 *
 * The counters and the last-seen arguments make the *invocation* observable too,
 * not just the answer: a candidate that never called the callback, or called it
 * with the wrong `(a, b)`, is caught even where the returned word agrees.
 */
static int gcb_new_calls;
static int gcb_new_last_a = -1;
static int gcb_new_last_b = -1;
static int gcb_new_arg_seen;
static int gcb_old_calls;
static int gcb_old_last_a = -1;
static int gcb_old_last_b = -1;
static void *gcb_old_arg_seen;

static int gcb_new(int a, int b, BN_GENCB *cb)
{
    gcb_new_calls++;
    gcb_new_last_a = a;
    gcb_new_last_b = b;
    gcb_new_arg_seen = BN_GENCB_get_arg(cb) == (void *)0x5eed;
    return 42;
}

static void gcb_old(int a, int b, void *arg)
{
    gcb_old_calls++;
    gcb_old_last_a = a;
    gcb_old_last_b = b;
    gcb_old_arg_seen = arg;
}

int main(void)
{
    ctx = BN_CTX_new();
    if (ctx == NULL) {
        printf("ctx=NULL\n");
        return 1;
    }
    printf("ctx.present=%d\n", ctx != NULL);

    /* --- lifetime -------------------------------------------------------- */
    {
        BIGNUM *a = BN_new(), *b = BN_dup(a), *c = BN_new();

        shape("new", a);
        printf("dup_of_zero.zero=%d\n", BN_is_zero(b));
        printf("set_word.ret=%d\n", BN_set_word(a, 12345));
        printf("set_word.value=%lu\n", BN_get_word(a));
        printf("get_word.neg=%d\n", BN_is_negative(a));
        printf("copy.ret=%d\n", BN_copy(c, a) != NULL);
        printf("copy.equal=%d\n", BN_cmp(a, c) == 0);
        BN_swap(a, c);
        printf("swap.a=%lu\n", BN_get_word(a));
        printf("set_word.too_big=%lu\n", BN_set_word(a, 1) == 1 ? BN_get_word(a) : 0);
        BN_free(b);
        BN_free(c);
        BN_clear(a);
        printf("clear.zero=%d\n", BN_is_zero(a));
        printf("clear.neg=%d\n", BN_is_negative(a));
        /* A cleared object must still be usable. */
        printf("reuse.ret=%d\n", BN_set_word(a, 7));
        printf("reuse.value=%lu\n", BN_get_word(a));
        BN_clear_free(a);
        BN_free(NULL);
        printf("free_null.ret=1\n");
    }

    /* --- get_word's saturation and the one-limb boundary ------------------ */
    {
        BIGNUM *a = bn("ffffffffffffffff");

        printf("word.max=%lu\n", BN_get_word(a));
        BN_lshift(a, a, 1);
        printf("word.two_limbs=%lu\n", BN_get_word(a));
        printf("word.two_limbs_neg=%d\n", BN_is_negative(a));
        BN_free(a);
    }

    /* --- predicates and bits over shapes -------------------------------- */
    {
        const char *shapes[] = { "0", "1", "2", "ff", "ffffffffffffffff",
                                 "10000000000000000", "80000000000000000000000000000000" };
        size_t i;

        for (i = 0; i < sizeof(shapes) / sizeof(shapes[0]); i++) {
            char key[32];
            BIGNUM *a = bn(shapes[i]);

            snprintf(key, sizeof(key), "shape%zu", i);
            shape(key, a);
            printf("%s.is_word1=%d\n", key, BN_is_word(a, 1));
            printf("%s.abs_is_word_ff=%d\n", key, BN_abs_is_word(a, 0xff));
            printf("%s.bit0=%d\n", key, BN_is_bit_set(a, 0));
            printf("%s.bit63=%d\n", key, BN_is_bit_set(a, 63));
            printf("%s.bit64=%d\n", key, BN_is_bit_set(a, 64));
            printf("%s.bit200=%d\n", key, BN_is_bit_set(a, 200));
            printf("%s.bit_neg=%d\n", key, BN_is_bit_set(a, -1));
            printf("%s.num_bits_word_ff=%d\n", key, BN_num_bits_word(0xff));
            BN_free(a);
        }
        printf("bits_word_zero=%d\n", BN_num_bits_word(0));
    }

    /* --- conversions ----------------------------------------------------- */
    {
        BIGNUM *a = bn("deadbeefcafebabe0123456789abcdef");
        char *hex, *dec;
        unsigned char buf[32];
        int n;

        hex = BN_bn2hex(a);
        dec = BN_bn2dec(a);
        printf("conv.hex=%s\n", hex);
        printf("conv.dec=%s\n", dec);
        OPENSSL_free(hex);
        OPENSSL_free(dec);
        printf("conv.dec_consumed=%d\n", BN_dec2bn(&a, "295990755076957304698161171062762229231"));
        printf("conv.dec_round_trip=%d\n", BN_is_word(a, 1) ? 0 : 1);
        BN_free(a);

        a = bn("80");
        n = BN_bn2bin(a, buf);
        printf("bin.len=%d\n", n);
        printf("bin.first=%02x\n", buf[0]);
        {
            BIGNUM *b = BN_bin2bn(buf, n, NULL);
            printf("bin.round_trip=%d\n", b != NULL && BN_cmp(a, b) == 0);
            BN_free(b);
        }
        printf("pad.ret=%d\n", BN_bn2binpad(a, buf, 4));
        printf("pad.bytes=%02x%02x%02x%02x\n", buf[0], buf[1], buf[2], buf[3]);
        printf("pad.too_small=%d\n", BN_bn2binpad(a, buf, 1));
        printf("lepad.ret=%d\n", BN_bn2lebinpad(a, buf, 2));
        printf("lepad.bytes=%02x%02x\n", buf[0], buf[1]);
        {
            BIGNUM *b = BN_lebin2bn(buf, 2, NULL);
            printf("lebin.round_trip=%d\n", b != NULL && BN_cmp(a, b) == 0);
            BN_free(b);
        }
        n = BN_bn2mpi(a, NULL);
        printf("mpi.size=%d\n", n);
        if (n > 0 && n <= (int)sizeof(buf)) {
            int i;
            BN_bn2mpi(a, buf);
            for (i = 0; i < n; i++)
                printf("mpi.byte%d=%02x\n", i, buf[i]);
        }
        BN_free(a);

        /* A negative value and its conversions. */
        a = bn("-ff");
        printf("neg.bits=%d\n", BN_num_bits(a));
        printf("neg.bin=%d\n", BN_bn2bin(a, buf));
        printf("neg.bin_byte=%02x\n", buf[0]);
        printf("neg.lepad2=%d\n", BN_bn2lebinpad(a, buf, 2));
        printf("neg.lepad_bytes=%02x%02x\n", buf[0], buf[1]);
        printf("neg.signed_le2=%d\n", BN_signed_bn2lebin(a, buf, 2));
        printf("neg.signed_bytes=%02x%02x\n", buf[0], buf[1]);
        {
            BIGNUM *b = BN_signed_lebin2bn(buf, 2, NULL);
            printf("neg.signed_round_trip=%d\n", b != NULL && BN_cmp(a, b) == 0);
            BN_free(b);
        }
        BN_free(a);
        /* BN_free does not clear the caller's pointer, so it must be cleared
         * here: the `&a` conversions below reuse the slot and would otherwise
         * operate on freed memory. */
        a = NULL;

        printf("asc.hex=%d\n", BN_asc2bn(&a, "0x10"));
        printf("asc.hex_value=%lu\n", BN_get_word(a));
        printf("asc.neg=%d\n", BN_asc2bn(&a, "-0x10"));
        printf("asc.neg_value_neg=%d\n", BN_is_negative(a));
        printf("asc.dec=%d\n", BN_asc2bn(&a, "255"));
        printf("asc.dec_value=%lu\n", BN_get_word(a));
        printf("hex2bn.bad=%d\n", BN_hex2bn(&a, "zz"));
        BN_free(a);
    }

    /* --- arithmetic: the shapes that break carries and borrows ----------- */
    {
        const char *pairs[][2] = {
            { "0", "0" }, { "1", "-1" }, { "ffffffffffffffff", "1" },
            { "ffffffffffffffffffffffffffffffff", "1" },
            { "80000000000000000000000000000000", "80000000000000000000000000000000" },
            { "-ffffffffffffffff", "1" }, { "123456789abcdef", "fedcba987654321" },
            { "-123456789abcdef", "fedcba987654321" },
        };
        size_t i;

        for (i = 0; i < sizeof(pairs) / sizeof(pairs[0]); i++) {
            char key[32];
            BIGNUM *a = bn(pairs[i][0]), *b = bn(pairs[i][1]);
            BIGNUM *r = BN_new();

            snprintf(key, sizeof(key), "arith%zu", i);
            printf("%s.a_neg=%d\n", key, BN_is_negative(a));
            printf("%s.add=%d\n", key, BN_add(r, a, b));
            show(key, r);
            printf("%s.sub=%d\n", key, BN_sub(r, a, b));
            show(key, r);
            printf("%s.mul=%d\n", key, BN_mul(r, a, b, ctx));
            show(key, r);
            printf("%s.sqr=%d\n", key, BN_sqr(r, a, ctx));
            show(key, r);
            printf("%s.uadd=%d\n", key, BN_uadd(r, a, b));
            show(key, r);
            printf("%s.usub=%d\n", key, BN_usub(r, a, b));
            show(key, r);
            printf("%s.cmp=%d\n", key, BN_cmp(a, b));
            printf("%s.ucmp=%d\n", key, BN_ucmp(a, b));
            /* Aliasing: r may be a, which the authority documents and uses. */
            printf("%s.self_add=%d\n", key, BN_add(a, a, b));
            show(key, a);
            BN_free(a);
            BN_free(b);
            BN_free(r);
        }
    }

    /* --- division, against its definition -------------------------------- */
    division_case("div0", "100", "7");
    division_case("div1", "-100", "7");
    division_case("div2", "100", "-7");
    division_case("div3", "-100", "-7");
    division_case("div4", "1", "100");
    division_case("div5", "0", "7");
    division_case("div6", "ffffffffffffffffffffffffffffffff", "10000000000000000");
    division_case("div7", "80000000000000000000000000000001", "ffffffffffffffff");
    division_case("div8", "-80000000000000000000000000000001", "ffffffffffffffff");

    /* A zero divisor fails and returns 0; what the queue holds afterwards is
     * part of the contract, so it is compared. */
    {
        BIGNUM *a = bn("10"), *b = BN_new(), *q = BN_new(), *r = BN_new();

        ERR_clear_error();
        printf("divzero.ret=%d\n", BN_div(q, r, a, b, ctx));
        printf("divzero.err=%lu\n", ERR_peek_error());
        printf("divzero.q_zero=%d\n", BN_is_zero(q));
        ERR_clear_error();
        printf("nnmodzero.ret=%d\n", BN_nnmod(r, a, b, ctx));
        printf("nnmodzero.err=%lu\n", ERR_peek_error());
        ERR_clear_error();
        printf("inversezero.ret_is_null=%d\n", BN_mod_inverse(NULL, a, b, ctx) == NULL);
        printf("inversezero.err=%lu\n", ERR_peek_error());
        ERR_clear_error();
        BN_free(a);
        BN_free(b);
        BN_free(q);
        BN_free(r);
    }

    /* --- word operations -------------------------------------------------- */
    {
        BIGNUM *a = bn("10000000000000000");

        printf("word.add=%d\n", BN_add_word(a, 1));
        show("word.add_val", a);
        printf("word.sub=%d\n", BN_sub_word(a, 1));
        show("word.sub_val", a);
        printf("word.mul=%d\n", BN_mul_word(a, 3));
        show("word.mul_val", a);
        printf("word.mod=%lu\n", BN_mod_word(a, 7));
        printf("word.div=%lu\n", BN_div_word(a, 7));
        show("word.div_val", a);
        printf("word.mod_zero=%lu\n", BN_mod_word(a, 0));
        printf("word.div_zero=%lu\n", BN_div_word(a, 0));
        BN_free(a);
        a = bn("1");
        printf("word.sub_negative=%d\n", BN_sub_word(a, 5));
        show("word.sub_negative_val", a);
        BN_free(a);
    }

    /* --- shifts ---------------------------------------------------------- */
    {
        BIGNUM *a = bn("deadbeefcafebabe");
        BIGNUM *r = BN_new();

        printf("shift.l3=%d\n", BN_lshift(r, a, 3));
        show("shift.l3_val", r);
        printf("shift.l64=%d\n", BN_lshift(r, a, 64));
        show("shift.l64_val", r);
        printf("shift.l1=%d\n", BN_lshift1(r, a));
        show("shift.l1_val", r);
        printf("shift.r3=%d\n", BN_rshift(r, a, 3));
        show("shift.r3_val", r);
        printf("shift.r1=%d\n", BN_rshift1(r, a));
        show("shift.r1_val", r);
        printf("shift.r_far=%d\n", BN_rshift(r, a, 200));
        show("shift.r_far_val", r);
        printf("shift.negative_arg=%d\n", BN_lshift(r, a, -1));
        printf("shift.negative_arg_r=%d\n", BN_rshift(r, a, -1));
        /* A negative operand: the shift moves the magnitude and keeps the sign. */
        BN_set_negative(a, 1);
        printf("shift.neg_r1=%d\n", BN_rshift1(r, a));
        show("shift.neg_r1_val", r);
        printf("shift.neg_l3=%d\n", BN_lshift(r, a, 3));
        show("shift.neg_l3_val", r);
        BN_free(a);
        BN_free(r);
    }

    /* --- mask_bits -------------------------------------------------------- */
    {
        BIGNUM *a = bn("ffffffffffffffffffff");

        printf("mask.64=%d\n", BN_mask_bits(a, 64));
        show("mask.64_val", a);
        printf("mask.beyond=%d\n", BN_mask_bits(a, 200));
        show("mask.beyond_val", a);
        printf("mask.0=%d\n", BN_mask_bits(a, 0));
        show("mask.0_val", a);
        printf("mask.negative=%d\n", BN_mask_bits(a, -1));
        BN_free(a);
    }

    /* --- exponentiation, inverse, gcd, sqrt ------------------------------- */
    {
        BIGNUM *a = bn("3"), *p = bn("100"), *m = bn("1000000007"), *r = BN_new();

        printf("exp.a_p=%d\n", BN_exp(r, a, p, ctx));
        show("exp.a_p_val", r);
        printf("modexp.ret=%d\n", BN_mod_exp(r, a, p, m, ctx));
        show("modexp.val", r);
        printf("modexp_simple.ret=%d\n", BN_mod_exp_simple(r, a, p, m, ctx));
        show("modexp_simple.val", r);
        /* A negative exponent must fail rather than answer something. */
        BN_set_negative(p, 1);
        printf("modexp.neg_exp=%d\n", BN_mod_exp(r, a, p, m, ctx));
        BN_set_negative(p, 0);
        BN_free(a);
        BN_free(p);
        BN_free(m);
        BN_free(r);
    }
    {
        BIGNUM *a = bn("3"), *n = bn("11"), *r = BN_new();

        printf("inverse.ret=%d\n", BN_mod_inverse(r, a, n, ctx) != NULL);
        show("inverse.val", r);
        BN_free(a);
        BN_free(n);
        a = bn("6");
        n = bn("9");
        ERR_clear_error();
        printf("inverse.none=%d\n", BN_mod_inverse(r, a, n, ctx) == NULL);
        printf("inverse.none_err=%lu\n", ERR_peek_error());
        ERR_clear_error();
        BN_free(a);
        BN_free(n);
        BN_free(r);
    }
    {
        BIGNUM *a = bn("100000000000000000000"), *b = bn("48"), *r = BN_new();

        printf("gcd.ret=%d\n", BN_gcd(r, a, b, ctx));
        show("gcd.val", r);
        printf("coprime.ret=%d\n", BN_are_coprime(a, b, ctx));
        BN_free(a);
        BN_free(b);
        BN_free(r);
    }
    /* --- mod family consistency ------------------------------------------ */
    {
        /* mod_sqrt on a residue and on a non-residue: the second must report
         * through the queue rather than answer a plausible value. */
        BIGNUM *a = bn("4"), *p = bn("1000000007"), *r = BN_new();

        printf("modsqrt.ret=%d\n", BN_mod_sqrt(r, a, p, ctx) != NULL);
        {
            BIGNUM *sq = BN_new();
            if (sq != NULL && BN_mod_sqr(sq, r, p, ctx))
                printf("modsqrt.checks=%d\n", BN_cmp(sq, a) == 0);
            BN_free(sq);
        }
        BN_free(a);
        a = bn("3");
        ERR_clear_error();
        printf("modsqrt.none=%d\n", BN_mod_sqrt(r, a, p, ctx) == NULL);
        printf("modsqrt.none_err=%lu\n", ERR_peek_error());
        ERR_clear_error();
        BN_free(a);
        BN_free(p);
        BN_free(r);
    }

    /* --- mod family consistency ------------------------------------------ */
    {
        BIGNUM *a = bn("-100"), *b = bn("7"), *m = bn("13"), *r = BN_new(), *r2 = BN_new();

        printf("modadd.ret=%d\n", BN_mod_add(r, a, b, m, ctx));
        show("modadd.val", r);
        printf("modsub.ret=%d\n", BN_mod_sub(r, a, b, m, ctx));
        show("modsub.val", r);
        printf("modmul.ret=%d\n", BN_mod_mul(r, a, b, m, ctx));
        show("modmul.val", r);
        printf("modsqr.ret=%d\n", BN_mod_sqr(r2, b, m, ctx));
        show("modsqr.val", r2);
        printf("modlshift.ret=%d\n", BN_mod_lshift(r, b, 3, m, ctx));
        show("modlshift.val", r);
        printf("modlshift1.ret=%d\n", BN_mod_lshift1(r, b, m, ctx));
        show("modlshift1.val", r);
        printf("modadd_quick.ret=%d\n", BN_mod_add_quick(r, b, b, m));
        show("modadd_quick.val", r);
        printf("modsub_quick.ret=%d\n", BN_mod_sub_quick(r, b, b, m));
        show("modsub_quick.val", r);
        printf("modlshift_quick.ret=%d\n", BN_mod_lshift_quick(r, b, 3, m));
        show("modlshift_quick.val", r);
        printf("modlshift1_quick.ret=%d\n", BN_mod_lshift1_quick(r, b, m));
        show("modlshift1_quick.val", r);
        BN_free(a);
        BN_free(b);
        BN_free(m);
        BN_free(r);
        BN_free(r2);
    }

    /* --- CTX discipline --------------------------------------------------- */
    {
        BIGNUM *a, *b;

        BN_CTX_start(ctx);
        a = BN_CTX_get(ctx);
        b = BN_CTX_get(ctx);
        printf("ctx.get_cleared=%d\n", BN_is_zero(a) && BN_is_zero(b));
        printf("ctx.two_distinct=%d\n", a != b);
        BN_set_word(a, 5);
        BN_set_word(b, 6);
        printf("ctx.a=%lu\n", BN_get_word(a));
        printf("ctx.b=%lu\n", BN_get_word(b));
        BN_CTX_end(ctx);
        /* After end, the same slots come back, cleared — the reuse the type
         * exists for, and observable. */
        BN_CTX_start(ctx);
        printf("ctx.reuse_cleared=%d\n", BN_is_zero(BN_CTX_get(ctx)));
        BN_CTX_end(ctx);
        /* Nested bracketing must restore the inner mark only. */
        BN_CTX_start(ctx);
        printf("ctx.outer=%d\n", BN_CTX_get(ctx) != NULL);
        BN_CTX_start(ctx);
        printf("ctx.inner=%d\n", BN_CTX_get(ctx) != NULL);
        BN_CTX_end(ctx);
        printf("ctx.after_inner=%d\n", BN_CTX_get(ctx) != NULL);
        BN_CTX_end(ctx);
        printf("ctx.new=%d\n", BN_CTX_new() != NULL);
    }

    /* --- flags and the constant-time swap -------------------------------- */
    {
        BIGNUM *a = bn("1234"), *b = bn("abcd");

        printf("flags.none=%d\n", BN_get_flags(a, 0x04));
        BN_set_flags(a, 0x04);
        printf("flags.set=%d\n", BN_get_flags(a, 0x04));
        printf("flags.other=%d\n", BN_get_flags(a, 0x01));
        /* condition 0 must leave both operands alone ... */
        BN_consttime_swap(0, a, b, 2);
        show("ctswap.zero_a", a);
        show("ctswap.zero_b", b);
        /* ... and condition 1 must exchange them. */
        BN_consttime_swap(1, a, b, 2);
        show("ctswap.one_a", a);
        show("ctswap.one_b", b);
        BN_free(a);
        BN_free(b);
    }

    /* --- Montgomery ------------------------------------------------------- */
    {
        BN_MONT_CTX *mont = BN_MONT_CTX_new();
        BIGNUM *odd = bn("1000000007");
        BIGNUM *even = bn("1000000008");
        BIGNUM *a = bn("123456789abcdef");
        BIGNUM *r = BN_new(), *r2 = BN_new();
        BIGNUM *zero = BN_new();

        printf("mont.new=%d\n", mont != NULL);
        printf("mont.set=%d\n", BN_MONT_CTX_set(mont, odd, ctx));
        printf("mont.to=%d\n", BN_to_montgomery(r, a, mont, ctx));
        show("mont.to_val", r);
        printf("mont.from=%d\n", BN_from_montgomery(r2, r, mont, ctx));
        show("mont.from_val", r2);
        printf("mont.round_trip=%d\n", BN_cmp(a, r2) == 0);
        printf("mont.mul=%d\n", BN_mod_mul_montgomery(r2, r, r, mont, ctx));
        show("mont.mul_val", r2);
        printf("mont.to_zero=%d\n", BN_to_montgomery(r2, zero, mont, ctx));
        show("mont.to_zero_val", r2);
        printf("mont.from_zero=%d\n", BN_from_montgomery(r2, zero, mont, ctx));
        show("mont.from_zero_val", r2);
        /* An even modulus has no Montgomery context, and the authority says so
         * through the inverse it cannot form. The refusal is exercised on a
         * **separate** context: a context is bound to one modulus, and passing a
         * mismatched one to `BN_mod_exp_mont` is out of contract — which the first
         * version of this probe did, and the authority answered 0 for it. */
        {
            BN_MONT_CTX *other = BN_MONT_CTX_new();
            ERR_clear_error();
            printf("mont.set_even=%d\n", BN_MONT_CTX_set(other, even, ctx));
            printf("mont.set_even_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            printf("mont.set_zero=%d\n", BN_MONT_CTX_set(other, zero, ctx));
            printf("mont.set_zero_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            BN_MONT_CTX_free(other);
        }
        /* The exponentiation entry points refuse an even modulus. */
        {
            BIGNUM *p = bn("100");
            printf("mont.exp=%d\n", BN_mod_exp_mont(r, a, p, odd, ctx, mont));
            show("mont.exp_val", r);
            ERR_clear_error();
            printf("mont.exp_no_mont=%d\n", BN_mod_exp_mont(r, a, p, odd, ctx, NULL));
            show("mont.exp_no_mont_val", r);
            printf("mont.exp_direct=%d\n", BN_mod_exp(r, a, p, odd, ctx));
            show("mont.exp_direct_val", r);
            ERR_clear_error();
            printf("mont.exp_even=%d\n", BN_mod_exp_mont(r, a, p, even, ctx, mont));
            printf("mont.exp_even_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            printf("mont.exp_ct=%d\n", BN_mod_exp_mont_consttime(r, a, p, odd, ctx, mont));
            show("mont.exp_ct_val", r);
            printf("mont.exp_ct_even=%d\n", BN_mod_exp_mont_consttime(r, a, p, even, ctx, mont));
            printf("mont.exp_ct_even_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            printf("mont.exp_word=%d\n", BN_mod_exp_mont_word(r, 3, p, odd, ctx, mont));
            show("mont.exp_word_val", r);
            printf("mont.exp2=%d\n", BN_mod_exp2_mont(r, a, p, a, p, odd, ctx, mont));
            show("mont.exp2_val", r);
            BN_free(p);
        }
        BN_MONT_CTX_free(mont);
        BN_free(odd);
        BN_free(even);
        BN_free(a);
        BN_free(r);
        BN_free(r2);
        BN_free(zero);
    }

    /* --- reciprocal ------------------------------------------------------- */
    {
        BN_RECP_CTX *recp = BN_RECP_CTX_new();
        BIGNUM *d = bn("1000000007");
        BIGNUM *zero = BN_new();
        BIGNUM *a = bn("123456789abcdef");
        BIGNUM *q = BN_new(), *r = BN_new();

        printf("recp.new=%d\n", recp != NULL);
        printf("recp.set=%d\n", BN_RECP_CTX_set(recp, d, ctx));
        printf("recp.div=%d\n", BN_div_recp(q, r, a, recp, ctx));
        show("recp.div_q", q);
        show("recp.div_r", r);
        /* The reciprocal context is a speed device: the same truncated
         * division the direct path computes. */
        {
            BIGNUM *q2 = BN_new(), *r2 = BN_new();
            printf("recp.div_agrees=%d\n",
                   BN_div(q2, r2, a, d, ctx) && BN_cmp(q, q2) == 0 && BN_cmp(r, r2) == 0);
            BN_free(q2);
            BN_free(r2);
        }
        printf("recp.mul_recip=%d\n", BN_mod_mul_reciprocal(r, a, a, recp, ctx));
        show("recp.mul_recip_val", r);
        printf("recp.mod_exp=%d\n", BN_mod_exp_recp(r, a, d, d, ctx));
        show("recp.mod_exp_val", r);
        printf("recp.reciprocal=%d\n", BN_reciprocal(r, d, 128, ctx));
        show("recp.reciprocal_val", r);
        ERR_clear_error();
        printf("recp.set_zero=%d\n", BN_RECP_CTX_set(recp, zero, ctx));
        printf("recp.set_zero_err=%lu\n", ERR_peek_error());
        ERR_clear_error();
        BN_RECP_CTX_free(recp);
        BN_free(d);
        BN_free(zero);
        BN_free(a);
        BN_free(q);
        BN_free(r);
    }

    /* --- named primes ----------------------------------------------------- */
    {
        const BIGNUM *p;

        p = BN_get0_nist_prime_192();
        show("nist192", p);
        p = BN_get0_nist_prime_224();
        show("nist224", p);
        p = BN_get0_nist_prime_256();
        show("nist256", p);
        p = BN_get0_nist_prime_384();
        show("nist384", p);
        p = BN_get0_nist_prime_521();
        show("nist521", p);
        /* The static objects are the same object on every call. */
        printf("nist192.same=%d\n", BN_get0_nist_prime_192() == BN_get0_nist_prime_192());
        show("rfc2409_768", BN_get_rfc2409_prime_768(NULL));
        show("rfc2409_1024", BN_get_rfc2409_prime_1024(NULL));
        show("rfc3526_1536", BN_get_rfc3526_prime_1536(NULL));
        show("rfc3526_2048", BN_get_rfc3526_prime_2048(NULL));
        show("rfc3526_3072", BN_get_rfc3526_prime_3072(NULL));
        show("rfc3526_4096", BN_get_rfc3526_prime_4096(NULL));
        show("rfc3526_6144", BN_get_rfc3526_prime_6144(NULL));
        show("rfc3526_8192", BN_get_rfc3526_prime_8192(NULL));
        /* A non-null destination is written and returned. */
        {
            BIGNUM *dst = BN_new();
            BIGNUM *ret = BN_get_rfc2409_prime_768(dst);
            printf("rfc.dst_same=%d\n", ret == dst);
            show("rfc.dst_val", dst);
            BN_free(dst);
        }
    }

    /* --- NIST reduction --------------------------------------------------- */
    {
        BIGNUM *a = bn("123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
        BIGNUM *r = BN_new();
        const BIGNUM *p192 = BN_get0_nist_prime_192();
        const BIGNUM *p224 = BN_get0_nist_prime_224();
        const BIGNUM *p256 = BN_get0_nist_prime_256();
        const BIGNUM *p384 = BN_get0_nist_prime_384();
        const BIGNUM *p521 = BN_get0_nist_prime_521();

        printf("nistmod.192=%d\n", BN_nist_mod_192(r, a, p192, ctx));
        show("nistmod.192_val", r);
        printf("nistmod.224=%d\n", BN_nist_mod_224(r, a, p224, ctx));
        show("nistmod.224_val", r);
        printf("nistmod.256=%d\n", BN_nist_mod_256(r, a, p256, ctx));
        show("nistmod.256_val", r);
        printf("nistmod.384=%d\n", BN_nist_mod_384(r, a, p384, ctx));
        show("nistmod.384_val", r);
        printf("nistmod.521=%d\n", BN_nist_mod_521(r, a, p521, ctx));
        show("nistmod.521_val", r);
        /* The selector answers by value, and the caller's `field` argument to a
         * reducer is ignored entirely. */
        printf("nistfunc.192=%d\n", BN_nist_mod_func(p192) != NULL);
        printf("nistfunc.521=%d\n", BN_nist_mod_func(p521) != NULL);
        printf("nistfunc.other=%d\n", BN_nist_mod_func(a) != NULL);
        printf("nistmod.192_ignores_field=%d\n",
               BN_nist_mod_192(r, a, p521, ctx) && BN_cmp(r, r) == 0);
        {
            BIGNUM *direct = BN_new();
            printf("nistmod.192_is_nnmod=%d\n",
                   BN_nnmod(direct, a, p192, ctx) && BN_nist_mod_192(r, a, p192, ctx)
                   && BN_cmp(r, direct) == 0);
            BN_free(direct);
        }
        BN_free(a);
        BN_free(r);
    }

    /* --- Kronecker symbol ------------------------------------------------- */
    {
        const char *pairs[][2] = {
            { "0", "0" }, { "1", "0" }, { "2", "0" }, { "3", "5" },
            { "100", "7" }, { "-100", "7" }, { "100", "-7" },
            { "-100", "-7" }, { "2", "4" }, { "123456789abcdef", "11" },
        };
        size_t i;

        for (i = 0; i < sizeof(pairs) / sizeof(pairs[0]); i++) {
            char key[32];
            BIGNUM *x = bn(pairs[i][0]), *y = bn(pairs[i][1]);

            snprintf(key, sizeof(key), "kron%zu", i);
            printf("%s=%d\n", key, BN_kronecker(x, y, ctx));
            BN_free(x);
            BN_free(y);
        }
    }

    /* --- blinding --------------------------------------------------------- */
    {
        BIGNUM *mod = bn("1000000007");
        BIGNUM *A = bn("3");
        BIGNUM *Ai = bn("555555556");
        BN_BLINDING *b = BN_BLINDING_new(A, Ai, mod);
        BIGNUM *n = bn("1234");

        printf("blinding.new=%d\n", b != NULL);
        printf("blinding.is_current=%d\n", b != NULL && BN_BLINDING_is_current_thread(b));
        printf("blinding.get_flags=%lu\n", b != NULL ? BN_BLINDING_get_flags(b) : 0);
        if (b != NULL) {
            BN_BLINDING_set_flags(b, 3);
            printf("blinding.set_flags=%lu\n", BN_BLINDING_get_flags(b));
            printf("blinding.lock=%d\n", BN_BLINDING_lock(b));
            printf("blinding.unlock=%d\n", BN_BLINDING_unlock(b));
        }
        /* `_invert_ex` with an explicit factor needs no context state; with a
         * null factor it uses the context's own inverse. */
        printf("blinding.invert_explicit=%d\n", BN_BLINDING_invert_ex(n, A, b, ctx));
        show("blinding.invert_explicit_val", n);
        printf("blinding.invert_own=%d\n", b != NULL && BN_BLINDING_invert_ex(n, NULL, b, ctx));
        show("blinding.invert_own_val", n);
        /* A context with no inverse reports it. */
        {
            BN_BLINDING *empty = BN_BLINDING_new(NULL, NULL, mod);
            ERR_clear_error();
            printf("blinding.new_empty=%d\n", empty != NULL);
            printf("blinding.invert_empty=%d\n",
                   empty != NULL && BN_BLINDING_invert_ex(n, NULL, empty, ctx));
            printf("blinding.invert_empty_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            BN_BLINDING_free(empty);
        }
        /* A null modulus takes the error path rather than crashing. */
        printf("blinding.null_mod=%d\n", BN_BLINDING_new(A, Ai, NULL) == NULL);
        BN_BLINDING_free(b);
        BN_BLINDING_free(NULL);
        BN_free(mod);
        BN_free(A);
        BN_free(Ai);
        BN_free(n);
    }

    /* --- GF(2^m) ---------------------------------------------------------- */
    {
        /* x^8 + x^4 + x^3 + x + 1 (the AES field) and x^4 + x + 1. */
        static const int f8[] = { 8, 4, 3, 1, 0, -1 };
        static const int f4[] = { 4, 1, 0, -1 };
        /* A field with more terms than BN_GF2m_mod's arr[6] can hold. */
        static const int too_many[] = { 16, 15, 14, 13, 12, 11, 10, 9, 0, -1 };
        BIGNUM *p8 = bn("11b"), *p4 = bn("13");
        BIGNUM *a = bn("a5"), *b = bn("57");
        BIGNUM *r = BN_new(), *r2 = BN_new();
        int arr[10];

        printf("gf.add=%d\n", BN_GF2m_add(r, a, b));
        show("gf.add_val", r);
        printf("gf.add_self=%d\n", BN_GF2m_add(r, a, a));
        show("gf.add_self_val", r);

        printf("gf.poly2arr=%d\n", BN_GF2m_poly2arr(p8, arr, 10));
        printf("gf.poly2arr.0=%d.1=%d.2=%d.3=%d.4=%d.term=%d\n",
               arr[0], arr[1], arr[2], arr[3], arr[4], arr[5]);
        /* An even polynomial has no constant term, so there is no array. */
        {
            BIGNUM *even = bn("110");
            printf("gf.poly2arr_even=%d\n", BN_GF2m_poly2arr(even, arr, 10));
            BN_free(even);
        }
        printf("gf.arr2poly=%d\n", BN_GF2m_arr2poly(f8, r));
        show("gf.arr2poly_val", r);
        printf("gf.arr2poly_round_trip=%d\n", BN_cmp(r, p8) == 0);
        printf("gf.arr2poly4=%d\n", BN_GF2m_arr2poly(f4, r));
        show("gf.arr2poly4_val", r);

        printf("gf.mod=%d\n", BN_GF2m_mod(r, a, p8));
        show("gf.mod_val", r);
        {
            BIGNUM *big = bn("123456789abcdef");
            printf("gf.mod_big=%d\n", BN_GF2m_mod(r, big, p8));
            show("gf.mod_big_val", r);
            printf("gf.mod_arr_big=%d\n", BN_GF2m_mod_arr(r2, big, f8));
            printf("gf.mod_paths_agree=%d\n", BN_cmp(r, r2) == 0);
            BN_free(big);
        }
        /* A degree-zero modulus reduces everything to zero. */
        {
            static const int deg0[] = { 0, -1 };
            printf("gf.mod_deg0=%d\n", BN_GF2m_mod_arr(r, a, deg0));
            show("gf.mod_deg0_val", r);
        }
        /* An even modulus has no constant term, which is the invalid-length case. */
        {
            BIGNUM *even = bn("11a");
            ERR_clear_error();
            printf("gf.mod_even=%d\n", BN_GF2m_mod(r, a, even));
            printf("gf.mod_even_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            printf("gf.mod_too_many=%d\n", BN_GF2m_mod(r, a, p8));
            BN_free(even);
        }
        {
            BIGNUM *wide = bn("10000");   /* x^16, has no constant term */
            printf("gf.mod_noconst=%d\n", BN_GF2m_mod(r, a, wide));
            BN_free(wide);
        }

        printf("gf.mul=%d\n", BN_GF2m_mod_mul(r, a, b, p8, ctx));
        show("gf.mul_val", r);
        printf("gf.mul_arr=%d\n", BN_GF2m_mod_mul_arr(r2, a, b, f8, ctx));
        printf("gf.mul_paths_agree=%d\n", BN_cmp(r, r2) == 0);
        printf("gf.mul_same_operand=%d\n", BN_GF2m_mod_mul_arr(r2, a, a, f8, ctx));
        printf("gf.mul_same_matches_sqr=%d\n",
               BN_GF2m_mod_sqr_arr(r, a, f8, ctx) && BN_cmp(r, r2) == 0);
        printf("gf.sqr=%d\n", BN_GF2m_mod_sqr(r, a, p8, ctx));
        show("gf.sqr_val", r);
        printf("gf.sqr_arr=%d\n", BN_GF2m_mod_sqr_arr(r2, a, f8, ctx));
        printf("gf.sqr_paths_agree=%d\n", BN_cmp(r, r2) == 0);
        {
            BIGNUM *two = bn("2");
            printf("gf.exp_two=%d\n", BN_GF2m_mod_exp(r2, a, two, p8, ctx));
            printf("gf.exp_two_is_sqr=%d\n", BN_cmp(r, r2) == 0);
            BN_free(two);
        }
        printf("gf.exp=%d\n", BN_GF2m_mod_exp(r, a, b, p8, ctx));
        show("gf.exp_val", r);
        {
            BIGNUM *seven = bn("7");
            printf("gf.exp_arr=%d\n", BN_GF2m_mod_exp_arr(r2, a, seven, f8, ctx));
            printf("gf.exp_and_exp_arr_agree_with_seven=%d\n",
                   BN_GF2m_mod_exp(r, a, seven, p8, ctx) && BN_cmp(r, r2) == 0);
            BN_free(seven);
        }
        {
            BIGNUM *zero = BN_new();
            printf("gf.exp_zero=%d\n", BN_GF2m_mod_exp(r, a, zero, p8, ctx));
            show("gf.exp_zero_val", r);
            BN_free(zero);
        }

        printf("gf.inv=%d\n", BN_GF2m_mod_inv(r, a, p8, ctx));
        show("gf.inv_val", r);
        printf("gf.inv_arr=%d\n", BN_GF2m_mod_inv_arr(r2, a, f8, ctx));
        printf("gf.inv_paths_agree=%d\n", BN_cmp(r, r2) == 0);
        /* a * a^-1 is one. */
        printf("gf.inv_identity=%d\n",
               BN_GF2m_mod_mul(r2, a, r, p8, ctx) && BN_is_word(r2, 1));
        /* x has no inverse modulo a field whose constant term is present unless
         * the modulus is reducible, so the failure path needs a reducible one. */
        {
            BIGNUM *reducible = bn("10");   /* x, even: no constant term */
            ERR_clear_error();
            printf("gf.inv_reducible=%d\n", BN_GF2m_mod_inv(r2, a, reducible, ctx));
            printf("gf.inv_reducible_err=%lu\n", ERR_peek_error());
            ERR_clear_error();
            BN_free(reducible);
        }

        printf("gf.div=%d\n", BN_GF2m_mod_div(r, a, b, p8, ctx));
        show("gf.div_val", r);
        printf("gf.div_arr=%d\n", BN_GF2m_mod_div_arr(r2, a, b, f8, ctx));
        printf("gf.div_paths_agree=%d\n", BN_cmp(r, r2) == 0);
        printf("gf.div_identity=%d\n",
               BN_GF2m_mod_mul(r2, r, b, p8, ctx) && BN_cmp(r2, a) == 0);
        printf("gf.div4=%d\n", BN_GF2m_mod_div(r, a, b, p4, ctx));
        show("gf.div4_val", r);

        BN_free(p8);
        BN_free(p4);
        BN_free(a);
        BN_free(b);
        BN_free(r);
        BN_free(r2);
    }

    /* --- BN_GENCB -------------------------------------------------------- */
    {
        BN_GENCB *cb = BN_GENCB_new();
        void *sentinel = (void *)0x5eed;

        printf("gencb.new_present=%d\n", cb != NULL);
        /* No callback stored yet: the authority answers 1 rather than faulting, */
        /* which is what lets a generation loop run without one.              */
        printf("gencb.call_without_callback=%d\n", BN_GENCB_call(cb, 0, 0));
        printf("gencb.get_arg_initial=%d\n", BN_GENCB_get_arg(cb) == NULL);

        BN_GENCB_set(cb, gcb_new, sentinel);
        printf("gencb.get_arg_new=%d\n", BN_GENCB_get_arg(cb) == sentinel);
        /* The event codes are the probe's own distinct markers, not the */
        /* authority's internal names (`BN_GENCB_GENERATED` and */
        /* `BN_GENCB_PRIME_TEST` live in `bn_local.h` and are not installed). */
        /* What is compared is that the callback is handed back exactly what */
        /* `BN_GENCB_call` was given, which `gencb.new_last` prints. */
        printf("gencb.new_ret=%d\n", BN_GENCB_call(cb, 11, 7));
        printf("gencb.new_calls=%d\n", gcb_new_calls);
        printf("gencb.new_last=%d,%d\n", gcb_new_last_a, gcb_new_last_b);
        printf("gencb.new_saw_arg=%d\n", gcb_new_arg_seen);

        BN_GENCB_set_old(cb, gcb_old, sentinel);
        printf("gencb.get_arg_old=%d\n", BN_GENCB_get_arg(cb) == sentinel);
        /* The deprecated callback returns void, so the answer is 1 and not the */
        /* callback's own (nonexistent) result.                                */
        printf("gencb.old_ret=%d\n", BN_GENCB_call(cb, 13, 3));
        printf("gencb.old_calls=%d\n", gcb_old_calls);
        printf("gencb.old_last=%d,%d\n", gcb_old_last_a, gcb_old_last_b);
        printf("gencb.old_saw_arg=%d\n", gcb_old_arg_seen == sentinel);

        /* A later `set` replaces the other kind rather than accumulating, so the */
        /* old callback must not be reached once a new one is installed.         */
        BN_GENCB_set(cb, gcb_new, NULL);
        printf("gencb.replace_ret=%d\n", BN_GENCB_call(cb, 11, 9));
        printf("gencb.replace_calls=%d,%d\n", gcb_new_calls, gcb_old_calls);
        printf("gencb.replace_arg_cleared=%d\n", BN_GENCB_get_arg(cb) == NULL);

        printf("gencb.call_null=%d\n", BN_GENCB_call(NULL, 0, 0));
        BN_GENCB_free(cb);
        BN_GENCB_free(NULL);
    }

    BN_CTX_free(ctx);
    printf("done=1\n");
    return 0;
}
