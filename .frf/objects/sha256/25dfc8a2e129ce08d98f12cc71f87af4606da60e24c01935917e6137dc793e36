int main(void)
{
    static const unsigned char key[32] = { 0 };
    unsigned char out[64];
    int i, outl = 0;

    setvbuf(stdout, NULL, _IOLBF, 0);
    if (CRYPTO_set_mem_functions(my_malloc, my_realloc, my_free) != 1) {
        printf("mem.install=0\n");
        return 1;
    }
    printf("mem.install=1\n");

    for (i = 0; i < (int)(sizeof(rows) / sizeof(rows[0])); i++) {
        EVP_CIPHER *c = EVP_CIPHER_fetch(NULL, rows[i], NULL);
        EVP_CIPHER_CTX *ctx;

        printf("mem.%s.fetched=%d\n", rows[i], c != NULL);
        if (c == NULL)
            continue;

        begin();
        ctx = EVP_CIPHER_CTX_new();
        if (ctx != NULL) {
            ERR_clear_error();
            EVP_CipherInit_ex2(ctx, c, key, NULL, 1, NULL);
            ERR_clear_error();
            EVP_CipherUpdate(ctx, out, &outl, out, 0);
            ERR_clear_error();
            EVP_CIPHER_CTX_free(ctx);
        }
        EVP_CIPHER_free(c);
        end(rows[i]);
    }
    return 0;
}
