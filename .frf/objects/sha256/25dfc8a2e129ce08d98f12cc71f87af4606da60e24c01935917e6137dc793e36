/*
 * RT-CIPHER-MEM -- which authority translation unit does each default-provider cipher row pass as
 * the `file` argument to a caller-installed allocator?
 *
 * Why this is a court of its own
 * ------------------------------
 * `CRYPTO_set_mem_functions`'s callbacks take `(size_t num, const char *file, int line)`, and all
 * three are part of the published contract: an embedder that installs an allocator receives them.
 * The crate had recorded `num` for every cipher context (`courts/layout/measure-*.c` and the size
 * test in `src/provider/cipher.rs`) but had never asked what `file` is, and the answer was wrong
 * for every row: one shared constant named `providers/implementations/ciphers/ciphercommon.c`,
 * which is a translation unit no row's allocation is in at all. The rows' context constructors are
 * generated by the `IMPLEMENT_generic_cipher` macro, which `prov/ciphercommon.h` *defines* but
 * `cipher_aes.c`, `cipher_camellia.c`, `cipher_tdes_common.c`, `cipher_sm4.c`, `cipher_aria.c` and
 * `cipher_idea.c` each *invoke*, so `__FILE__` inside an expanded body is the invoking file.
 *
 * **This cannot be an arm of `RT-CIPHER`.** `CRYPTO_set_mem_functions` latches: the first non-zero
 * allocation through the default path clears `allow_customize` for the life of the process, and a
 * later install returns 0. `rt_cipher_probe.c` allocates long before any of its cipher arms would
 * run, so the installation has to be the first thing this program does -- which is also why the
 * finding was made by a separate *oracle* program (`courts/layout/oracle-mem-file.c`) before it
 * could be a court.
 *
 * What is compared, and what is deliberately not
 * ----------------------------------------------
 * The transcript is the **set of distinct `file` strings that name a
 * `providers/implementations/ciphers/` translation unit**, in first-seen order, per row, inside a
 * window that starts after the fetch and ends after the context is released. Every other `file` in
 * the window -- `crypto/evp/`, `crypto/property/`, `crypto/lhash/` and the rest -- is excluded by
 * construction, because the crate's *EVP layer* is not what this court is about and comparing it
 * whole would turn one finding into an unbounded one. The exclusion is the claim's scope, and it is
 * stated rather than implied: what this court proves is that the row's own provider allocation is
 * attributed to the authority's own translation unit for that row.
 *
 * **No counts and no sizes are printed.** A count would compare allocation *strategy* rather than
 * allocation *origin*, and the two sides need not allocate the same number of times; the sizes are
 * already `courts/layout/measure-*.c`'s subject and the size test's. `EVP_CipherInit_ex2` is given a
 * key and no IV so that every row reaches its `newctx`, which is the allocation in question, even
 * where an init later refuses.
 */
#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include <openssl/crypto.h>
#include <openssl/err.h>
#include <openssl/evp.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MEM_MAX 32
#define MEM_NAME 400
#define CIPHER_TU "providers/implementations/ciphers/"

static char seen[MEM_MAX][MEM_NAME];
static int nseen;
static int recording;

static void note(const char *file)
{
    int i;

    if (!recording || file == NULL)
        return;
    for (i = 0; i < nseen; i++) {
        if (strcmp(seen[i], file) == 0)
            return;
    }
    if (nseen < MEM_MAX && strlen(file) < MEM_NAME) {
        strcpy(seen[nseen], file);
        nseen++;
    }
}

static void *my_malloc(size_t n, const char *file, int line)
{
    (void)line;
    note(file);
    return malloc(n);
}

static void *my_realloc(void *p, size_t n, const char *file, int line)
{
    (void)line;
    note(file);
    return realloc(p, n);
}

static void my_free(void *p, const char *file, int line)
{
    (void)line;
    note(file);
    free(p);
}

static void begin(void)
{
    nseen = 0;
    recording = 1;
}

/* Only the provider cipher translation units, in first-seen order. */
static void end(const char *row)
{
    int i, n = 0;

    recording = 0;
    for (i = 0; i < nseen; i++) {
        if (strstr(seen[i], CIPHER_TU) != NULL) {
            printf("mem.%s.%d=%s\n", row, n, seen[i]);
            n++;
        }
    }
    printf("mem.%s.count=%d\n", row, n);
}

/* The default provider's cipher census, in `defltprov.c` order. It mirrors
