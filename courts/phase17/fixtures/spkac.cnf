# openssl-rs RT-CLI-BODIES fixture: a fixed SPKAC for `spkac`.
#
# The value is an RSA/MD5 Netscape SPKI produced offline by the authority's own
# `openssl spkac -key <fixed-key> -challenge challenge-123`. RSA PKCS#1 v1.5
# signing is deterministic, so the SPKAC is a pure function of that fixed key and
# challenge, and `spkac`'s print/verify/pubkey arms over it cannot drift.
[default]
SPKAC = 
