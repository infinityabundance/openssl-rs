+                .wrapping_add(1442695040888963407);
+            seed
+        };
+        for _ in 0..64 {
+            let h = ((next() as u128) << 64) | next() as u128;
+            let h = if h == 0 { 1 } else { h };
+            let mut data = vec![0u8; GHASH_MAX_WIDTH * 16];
+            for b in &mut data {
+                *b = next() as u8;
