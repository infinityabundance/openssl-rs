+                    block.copy_from_slice(&data[j * 16..j * 16 + 16]);
+                    serial = gf_mul(serial ^ u128::from_be_bytes(block), h);
+                }
+                let got = ghash_group(xi, &p, &data[..width * 16], width);
+                assert_eq!(got, serial, "width={width}");
