+/// Define one monomorphic `#[target_feature(enable = "bmi2")]` CIOS wrapper.
+///
+/// The wrapper's body is exactly the safe [`mont_mul_cios_fixed`] kernel — no
+/// intrinsics and no assembly. `#[target_feature]` may not be applied to a
+/// generic function, hence one monomorphic wrapper per admitted width; each is
+/// `unsafe fn` because the feature is a caller obligation.
+#[cfg(target_arch = "x86_64")]
+macro_rules! define_bmi2_cios_wrapper {
+    ($name:ident, $n:literal, $acc:literal) => {
+        /// # Safety
+        ///
+        /// The CPU must support BMI2. The only caller is the dispatch block in
+        /// [`mont_mul_cios_dispatch`] (boundary `BN-CIOS-BMI2-DISPATCH`), which
+        /// gates every wrapper on `is_x86_feature_detected!("bmi2")`.
+        #[target_feature(enable = "bmi2")]
+        unsafe fn $name(
+            a: &[Limb],
+            b: &[Limb],
+            out: &mut [Limb],
+            m: &[Limb],
+            n0: Limb,
+            t: &mut [Limb],
+            diff: &mut [Limb],
+        ) -> bool {
+            // The body is the portable kernel, unchanged and safe. Inlining it
+            // under this target feature is the whole optimisation.
+            mont_mul_cios_fixed::<$n, $acc>(a, b, out, m, n0, t, diff)
+        }
+    };
+}
