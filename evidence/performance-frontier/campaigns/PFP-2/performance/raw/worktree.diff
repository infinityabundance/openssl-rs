+static void make_operand(unsigned char *p, size_t n, uint64_t seed, int top_set,
+                         int odd) {
+    fill_seeded(seed, p, n);
+    if (top_set)
+        p[0] |= 0x80;
+    else
+        p[0] &= 0x7f;
+    if (odd)
+        p[n - 1] |= 1;
+    else
