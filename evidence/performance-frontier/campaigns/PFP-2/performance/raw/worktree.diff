+/* The PFP-0 operand derivation, byte for byte. */
+static void fill_seeded(uint64_t seed, unsigned char *p, size_t n) {
+    uint64_t s = seed ? seed : UINT64_C(0x9e3779b97f4a7c15);
+    size_t i;
+    for (i = 0; i < n; i++) {
+        s ^= s >> 12;
+        s ^= s << 25;
+        s ^= s >> 27;
+        p[i] = (unsigned char)(s >> 56);
+    }
+}
