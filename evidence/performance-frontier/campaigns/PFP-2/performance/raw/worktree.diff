+/// The `OPENSSL_ia32cap` mask has the authority's `OPENSSL_cpuid_setup`
+/// semantics for the extended word, and the same mask produces the same
+/// accelerated/portable arm decision.
+#[test]
+fn ia32cap_mask_matches_the_authority_semantics() {
+    const BMI2: u32 = 1 << 8;
+    const ADX: u32 = 1 << 19;
+    let both = BMI2 | ADX;
+    let raw = both | (1 << 5);
+
+    // No variable: the raw CPUID word.
+    assert_eq!(masked_extended_caps(raw, None), raw);
+    // A single word (no second delimiter) zeroes the extended pair.
+    assert_eq!(masked_extended_caps(raw, Some("0x1234")), 0);
+    assert_eq!(masked_extended_caps(raw, Some("~0x100")), 0);
+    assert_eq!(masked_extended_caps(raw, Some("")), 0);
+    // The second word assigns or clears, per `~`.
+    assert_eq!(masked_extended_caps(raw, Some(":0x1234")), 0x1234);
+    assert_eq!(masked_extended_caps(raw, Some(":~0x80000")), raw & !ADX);
+    assert_eq!(masked_extended_caps(raw, Some(":~0x80100")), raw & !both);
+    assert_eq!(masked_extended_caps(raw, Some(":~0")), raw);
+    // `::` skips the word and leaves the pair unchanged.
+    assert_eq!(masked_extended_caps(raw, Some("::")), raw);
+    // An empty second word zeroes the pair.
+    assert_eq!(masked_extended_caps(raw, Some(":")), 0);
+
+    // The arm decision is the authority's predicate on the masked word.
+    assert!(nistz256_eligible(masked_extended_caps(raw, None)));
+    assert!(nistz256_eligible(masked_extended_caps(raw, Some("::"))));
+    assert!(!nistz256_eligible(masked_extended_caps(
+        raw,
+        Some(":~0x80000")
+    )));
+    assert!(!nistz256_eligible(masked_extended_caps(
+        raw,
+        Some(":~0x100")
+    )));
+    assert!(!nistz256_eligible(masked_extended_caps(
+        raw,
+        Some(":0x100")
+    )));
+}
