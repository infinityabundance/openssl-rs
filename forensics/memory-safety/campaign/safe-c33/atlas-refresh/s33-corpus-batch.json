 "recipe_defects_fixed": [
  {
   "defect": "_prepare_aux extracted a source-tarball auxiliary with `tar xf <archive> <dir>`, which looks for a member named <dir>",
   "fix": "extract with `-C <aux-root>`; byte-identical for both subjects"
  },
  {
   "defect": "a development package's .pc symlink could dangle and abort the aux preparation",
   "fix": "skip a .pc whose target is not in the pinned aux set"
  },
  {
   "defect": "postfix `make makefiles` refused a non-empty LD_LIBRARY_PATH and had no db.h on the OS include path",
   "fix": "pass -DHAS_DB, clear LD_LIBRARY_PATH for the build, and keep {aux}/usr/bin (m4) on PATH; pin m4"
  },
  {
   "defect": "krb5 artifact named src/clients/kinit/kinit (no direct libcrypto NEEDED) and then a symlink",
   "fix": "build/link artifact is the regular src/lib/crypto/libk5crypto.so.3.1"
  },
  {
   "defect": "gss-ntlmssp configure required gettext/xsltproc/xmllint/docbook plus libunistring and com_err",
   "fix": "disable NLS, pin xsltproc/libxml2-utils/docbook-xsl/docbook-xml/libunistring/comerr-dev and generate a minimal XML catalog as a build input"
  },
  {
   "defect": "libgit2 could not find the system http-parser from the pinned aux",
   "fix": "pass HTTP_PARSER_INCLUDE_DIR/HTTP_PARSER_LIBRARY and the aux include/lib paths to CMake"
  },
  {
   "defect": "libcpp-httplib's no-op make target failed with `No targets`",
   "fix": "use `make -f /dev/null --eval='all:;@true' all`; the harness is built in pre_build"
  },
  {
   "defect": "Ruby was built without the digest extension that ext/openssl requires",
   "fix": "--with-ext=openssl,digest"
  },
  {
   "defect": "libcxxtools10 3.0.0 does not compile with GCC 12 (string_view static assertion)",
   "fix": "not fixed; recorded as ENVIRONMENT (2014 source vs current libstdc++)"
  }
 ],
