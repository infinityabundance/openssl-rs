{
  "schema": "openssl-rs/downstream-template-families/1",
  "rule": "Every entry is a small declarative recipe + workload. The build recipe is pristine (URL + sha256); the workload names a bucket template and supplies only argv/expectations. No candidate-specific patch is permitted.",
  "families": [
    {
      "family": "rhash",
      "bucket": "digest",
      "version": "1.4.5",
      "url": "https://github.com/rhash/RHash/archive/refs/tags/v1.4.5.tar.gz",
      "sha256": "6db837e7bbaa7c72c5fd43ca5af04b1d370c5ce32367b9f6a1f7b49b2338c09a",
      "archive": "tar.gz",
      "build_system": "configure",
      "configure": ["--enable-openssl", "--extra-cflags=-I{prefix}/include", "--extra-ldflags=-L{prefix}/lib"],
      "make": ["-j4"],
      "artifact": "librhash/librhash.so.1.4.5",
      "program": "rhash",
      "lib_paths": ["librhash"],
      "launch": ["--version"],
      "version_re": "RHash",
      "workload": {
        "template": "digest",
        "argv": ["--sha256", "{payload}"],
        "expect": "[0-9a-f]{64}",
        "negative_argv": ["--sha256", "{tampered}"],
        "negative": "different"
      }
    },
    {
      "family": "fsverity-utils",
      "bucket": "digest",
      "version": "1.6",
      "url": "https://github.com/ebiggers/fsverity-utils/archive/refs/tags/v1.6.tar.gz",
      "sha256": "c7aa6b17a8a069224321ff94e46fb91a6426828ca78170a879a52cef2597abb7",
      "archive": "tar.gz",
      "build_system": "make",
      "make": ["-j4"],
      "artifact": "fsverity",
      "program": "fsverity",
      "launch": ["--version"],
      "version_re": "fsverity",
      "workload": {
        "template": "digest",
        "argv": ["digest", "{payload}"],
        "expect": "sha256:[0-9a-f]{64}",
        "negative_argv": ["digest", "{tampered}"],
        "negative": "different"
      }
    },
    {
      "family": "gostsum",
      "bucket": "digest/HMAC/HKDF tool",
      "version": "3.0.3+git20251212.7f6d61a",
      "url": "https://deb.debian.org/debian/pool/main/libe/libengine-gost-openssl/libengine-gost-openssl_3.0.3+git20251212.7f6d61a.orig.tar.gz",
      "sha256": "3363e630d7b73aa79ba00707dd6b9ff5978ea68a7d2704375bdf52bd8f423aa5",
      "archive": "tar.gz",
      "build_system": "cmake",
      "configure": ["-DCMAKE_PREFIX_PATH={prefix}", "-DCMAKE_BUILD_TYPE=Release"],
      "make": ["-j4"],
      "artifact": "b/bin/gostsum",
      "program": "b/bin/gostsum",
      "launch": ["-h"],
      "version_re": "gostsum",
      "workload": {
        "template": "digest",
        "argv": ["{payload}"],
        "expect": "^[0-9a-f]{64}",
        "negative_argv": ["{tampered}"],
        "negative": "different"
      }
    },
    {
      "family": "siege",
      "bucket": "HTTP(S) client",
      "version": "4.1.6",
      "url": "https://download.joedog.org/siege/siege-4.1.6.tar.gz",
      "sha256": "309d589bfc819b6f15d2e5e8591b3c0c6f693624f5060eeac067a4d9a7757de9",
      "archive": "tar.gz",
      "build_system": "autotools",
      "configure": ["--with-ssl={prefix}"],
      "make": ["-j4"],
      "artifact": "src/siege",
      "program": "src/siege",
      "launch": ["--version"],
      "version_re": "SIEGE",
      "env": {"SIEGERC": "{root}/doc/siegerc"},
      "workload": {
        "template": "http_bench",
        "argv": ["-q", "-c1", "-r1", "-b", "{url}"],
        "expect": "Transactions:\\s+1",
        "negative": "plaintext"
      }
    },
    {
      "family": "wrk",
      "bucket": "HTTP(S) client",
      "version": "4.2.0",
      "url": "https://github.com/wg/wrk/archive/refs/tags/4.2.0.tar.gz",
      "sha256": "e255f696bff6e329f5d19091da6b06164b8d59d62cb9e673625bdcd27fe7bdad",
      "archive": "tar.gz",
      "build_system": "make",
      "pre_build": [["python3", "-c", "import zipfile; zipfile.ZipFile('deps/LuaJIT-2.1.zip').extractall('obj')"]],
      "make": ["-j4", "WITH_OPENSSL={prefix}"],
      "artifact": "wrk",
      "program": "wrk",
      "launch": ["-v"],
      "version_re": "wrk ",
      "workload": {
        "template": "http_bench",
        "argv": ["-t1", "-c1", "-d1s", "{url}"],
        "expect": "Requests/sec",
        "negative": "plaintext"
      }
    },
    {
      "family": "httrack",
      "bucket": "HTTP(S) client",
      "version": "3.49.2",
      "url": "https://download.httrack.com/httrack-3.49.2.tar.gz",
      "sha256": "4a017e8311035ec02ee2947e14022a5f1291c86c7e67e98ee762c9486f0db39d",
      "archive": "tar.gz",
      "build_system": "autotools",
      "configure": ["--disable-http2"],
      "make": ["-j4"],
      "artifact": "src/.libs/libhttrack.so.3.0.26",
      "program": "src/.libs/httrack",
      "lib_paths": ["src/.libs"],
      "launch": ["--version"],
      "version_re": "HTTrack",
      "workload": {
        "template": "http_mirror",
        "argv": ["{url}", "-O", "{workdir}/mirror", "-q"],
        "negative_argv": ["{url}", "-O", "{workdir}/mirror-neg", "-q"],
        "expect": "template-payload",
        "negative": "plaintext"
      }
    },
    {
      "family": "curl-minimal",
      "bucket": "HTTP(S) client",
      "version": "8.10.1",
      "url": "https://curl.se/download/curl-8.10.1.tar.gz",
      "sha256": "d15ebab765d793e2e96db090f0e172d127859d78ca6f6391d7eafecfd894bbc0",
      "archive": "tar.gz",
      "build_system": "autotools",
      "configure": ["--with-openssl={prefix}", "--without-libpsl", "--without-zstd",
                    "--without-brotli", "--disable-ldap", "--disable-ldaps",
                    "--without-libidn2", "--without-nghttp2", "--silent"],
      "make": ["-j4"],
      "artifact": "lib/.libs/libcurl.so*",
      "program": "src/.libs/curl",
      "lib_paths": ["lib/.libs"],
      "launch": ["-V"],
      "version_re": "curl \\d",
      "workload": {
        "template": "http_client",
        "argv": ["-sS", "--cacert", "{ca}", "{url}"],
        "expect": "template-payload",
        "negative": "wrong_ca"
      }
    },
    {
      "family": "gmnisrv",
      "bucket": "TLS generic server",
      "version": "1.0",
      "url": "https://git.sr.ht/~sircmpwn/gmnisrv/archive/1.0.tar.gz",
      "sha256": "b1257d6835aff453d6a321a1c6e50c485703692530e4bcfe35455d7aac45f3d5",
      "archive": "tar.gz",
      "build_system": "configure",
      "configure": ["--prefix={root}/.l7-install"],
      "make": ["-j4"],
      "pkgconfig_shim": true,
      "env_extra": {"CFLAGS": "-Wno-error=deprecated-declarations"},
      "artifact": "gmnisrv",
      "program": "gmnisrv",
      "launch": ["-h"],
      "version_re": "Usage:",
      "workload": {
        "template": "tls_server",
        "protocol": "gemini",
        "server_argv": ["-C", "{config}"],
        "config": "listen=127.0.0.1:{port}\n[:tls]\nstore={workdir}/certs\n[localhost]\nroot={workdir}/root\n",
        "cert_path": "{workdir}/certs/localhost.crt",
        "payload": "gemini://localhost/\r\n",
        "expect": "^20 ",
        "negative": "wrong_ca"
      }
    },
    {
      "family": "appx-util",
      "bucket": "signature/cert tool",
      "version": "0.5",
      "url": "https://github.com/OSInside/appx-util/archive/refs/tags/v0.5.tar.gz",
      "sha256": "6ddc12a7b7eb32c1c11d634abfec61da50047df0bb999fa7edfaa799d1d214fa",
      "archive": "tar.gz",
      "build_system": "cmake",
      "configure": ["-DCMAKE_PREFIX_PATH={prefix}", "-DCMAKE_BUILD_TYPE=Release"],
      "make": ["-j4"],
      "artifact": "b/appx",
      "program": "b/appx",
      "launch": ["-h"],
      "version_re": "Usage:.*appx",
      "workload": {
        "template": "signature",
        "argv": ["-o", "{workdir}/signed.appx", "-c", "{root}/Tests/App_TemporaryKey.pfx", "{payload_txt}"],
        "negative_argv": ["-o", "{workdir}/unsigned.appx", "{payload_txt}"],
        "artifact_entry": "AppxSignature.p7x",
        "payload": "template-payload"
      }
    },
    {
      "family": "openssh-client",
      "bucket": "TLS generic client",
      "version": "9.9p1",
      "url": "https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-9.9p1.tar.gz",
      "sha256": "b343fbcdbff87f15b1986e6e15d6d4fc9a7d36066be6b7fb507087ba8f966c02",
      "archive": "tar.gz",
      "build_system": "configure",
      "configure": ["--with-ssl-dir={prefix}", "--without-openssl-header-check",
                    "--without-pam", "--without-selinux", "--without-libedit",
                    "--without-ldns", "--without-kerberos5",
                    "--with-privsep-user=nobody", "--with-privsep-path={root}/.l7-privsep",
                    "--silent"],
      "make": ["-j4", "ssh", "sshd", "sshd-session", "ssh-keygen"],
      "artifact": "ssh",
      "program": "ssh",
      "launch": ["-V"],
      "version_re": "OpenSSH_",
      "workload": {
        "template": "ssh_client",
        "server": "sshd",
        "keygen": "ssh-keygen",
        "session": "sshd-session",
        "expect": "ok"
      }
    }
  ]
}
