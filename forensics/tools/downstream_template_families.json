      "artifact": "fsverity",
      "program": "fsverity",
      "launch": ["--version"],
      "version_re": "fsverity",
      "workload": {
        "template": "digest",
        "argv": ["digest", "{payload}"],
        "expect": "sha256:[0-9a-f]{64}",
        "negative_argv": ["digest", "{tampered}"],
        "negative": "different"
      }
    },
    {
